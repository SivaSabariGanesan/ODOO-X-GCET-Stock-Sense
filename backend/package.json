{
  "name": "@stocksense/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server/index.ts",
    "build": "bun build src/server/index.ts --target=bun --outdir dist",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push:pg",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "drizzle-orm": "^0.29.0",
    "hono": "^3.12.0",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.3",
    "prom-client": "^15.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.20.0",
    "typescript": "^5.3.0"
  }
}