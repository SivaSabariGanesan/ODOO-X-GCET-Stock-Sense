# Database Configuration
POSTGRES_DB=stocksense_db
POSTGRES_USER=stocksense
POSTGRES_PASSWORD=stocksense_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5437
DATABASE_URL=postgresql://stocksense:stocksense_pass@localhost:5437/stocksense_db

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT / Auth Secret
JWT_SECRET=your_jwt_secret_here

# App URL
VITE_API_BASE_URL=http://localhost:3000

# Email / SMTP Configuration (Optional for real email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="StockSense Security <noreply@stocksense.com>"
